          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== PIPELINE 3 ==================== -->
        <mxCell id="c_p3" value="&lt;b&gt;Pipeline 3: retrain.yml&lt;/b&gt;" style="swimlane;startSize=30;container=1;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="200" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="rt" value="&lt;b&gt;Retrain:&lt;/b&gt; Pull train-latest from ACR&lt;br&gt;→ run training on new data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="c_p3">
          <mxGeometry x="30" y="45" width="320" height="60" as="geometry" />
        </mxCell>
