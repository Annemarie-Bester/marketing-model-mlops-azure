        </mxCell>
        <mxCell id="push_main" value="&lt;b&gt;Push to main&lt;/b&gt;&lt;br&gt;(merge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c_triggers">
          <mxGeometry x="810" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sched" value="&lt;b&gt;Weekly schedule / manual /&lt;/b&gt;&lt;br&gt;drift alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c_triggers">
          <mxGeometry x="1260" y="40" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== PIPELINE 1 ==================== -->
        <mxCell id="c_p1" value="&lt;b&gt;Pipeline 1: pr-validation.yml&lt;/b&gt;" style="swimlane;startSize=30;container=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="val" value="gitleaks → Install → pip-audit → pytest&lt;br&gt;→ kubeconform → Build train image&lt;br&gt;→ Trivy scan → Run training&lt;br&gt;→ Build infer image → Trivy scan&lt;br&gt;→ smoke test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c_p1">
          <mxGeometry x="10" y="40" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== PIPELINE 2 (dev) ==================== -->
        <mxCell id="c_p2_dev" value="&lt;b&gt;Pipeline 2 (dev path)&lt;/b&gt;" style="swimlane;startSize=30;container=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="200" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ci_d" value="&lt;b&gt;CI:&lt;/b&gt; Install → pip-audit → pytest&lt;br&gt;→ kubeconform → DetectChanges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="c_p2_dev">
          <mxGeometry x="20" y="45" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="train_d" value="&lt;b&gt;TrainModel (conditional):&lt;/b&gt; Build + run&lt;br&gt;training container → Trivy scan&lt;br&gt;→ upload to Blob → push train image to ACR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="c_p2_dev">
          <mxGeometry x="20" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cd_d" value="&lt;b&gt;CD_Dev:&lt;/b&gt; Promote model to staging/ in Blob&lt;br&gt;→ build infer image → Trivy scan&lt;br&gt;→ push (dev-buildId) → deploy bank-marketing-dev&lt;br&gt;→ in-cluster smoke test → rolling restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="c_p2_dev">
          <mxGeometry x="20" y="280" width="320" height="100" as="geometry" />
        </mxCell>
        <!-- Internal edges -->
        <mxCell id="e_ci_d_train_d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="ci_d" target="train_d" parent="c_p2_dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_train_d_cd_d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="train_d" target="cd_d" parent="c_p2_dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== PIPELINE 2 (main) ==================== -->
        <mxCell id="c_p2_main" value="&lt;b&gt;Pipeline 2 (main path)&lt;/b&gt;" style="swimlane;startSize=30;container=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ci_m" value="&lt;b&gt;CI:&lt;/b&gt; Install → pip-audit → pytest&lt;br&gt;→ kubeconform → DetectChanges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="c_p2_main">
          <mxGeometry x="20" y="45" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="train_m" value="&lt;b&gt;TrainModel (conditional):&lt;/b&gt; Build + run&lt;br&gt;training container → Trivy scan&lt;br&gt;→ upload to Blob → push train image to ACR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="c_p2_main">
          <mxGeometry x="20" y="155" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cd_m" value="&lt;b&gt;CD_Main:&lt;/b&gt; Promote model to production/ in Blob&lt;br&gt;→ build infer image → Trivy scan&lt;br&gt;→ push (buildId + latest) → deploy bank-marketing&lt;br&gt;→ live smoke test → rolling restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="c_p2_main">
          <mxGeometry x="20" y="280" width="320" height="100" as="geometry" />
        </mxCell>
        <!-- Internal edges -->
