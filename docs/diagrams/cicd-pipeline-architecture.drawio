                <mxCell id="ci_m" value="&lt;b&gt;CI: Install &lt;br&gt;&lt;/b&gt;→ pip-audit &lt;br&gt;&lt;font&gt;→ pytest&lt;/font&gt;&lt;div&gt;&lt;font&gt;→ kubeconform&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;→ DetectChanges&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="c_p2_main" vertex="1">
