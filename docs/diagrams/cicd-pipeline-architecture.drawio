        </mxCell>
        <mxCell id="push_dev" value="&lt;b&gt;Push to dev&lt;/b&gt;&lt;br&gt;(merge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c_triggers">
