FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

# Install only inference-time dependencies from the curated requirements-infer.txt
# This file lives in source control — not generated at training time
COPY requirements-infer.txt .
RUN pip install --no-cache-dir -r requirements-infer.txt

COPY src/ src/
COPY config.yaml .

# Create the artifacts directory — model.pkl is NOT baked into the image.
# It is either:
#   1. Mounted as a volume (local dev: -v ./artifacts:/app/artifacts)
#   2. Loaded from Azure Blob Storage (set STORAGE_BACKEND=azure_blob)
RUN mkdir -p artifacts && chown appuser:appuser artifacts

USER appuser

EXPOSE 8000

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]