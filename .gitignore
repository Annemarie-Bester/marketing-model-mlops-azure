# Data — raw files and outputs not tracked; directory structure preserved via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/results/*
!data/results/.gitkeep

# Model artifacts — ignore everything except .gitkeep (preserves directory structure).
# metrics.json is a generated artifact; the production baseline lives in Blob Storage
# (production/artifacts/metrics.json) and is fetched by retrain.yml at pipeline time.
artifacts/*
!artifacts/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
GAPS.md
proposed-improvements.md

# Environment variables
.env

