# Data (raw files not tracked — add processed artifacts only if needed)
data/raw/
data/results/

# Model artifacts — keep directory structure, ignore binary/large files
artifacts/*.pkl
# metrics.json is intentionally tracked (shows results to reviewers)
!artifacts/metrics.json
!artifacts/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Environment variables
.env

# Ignore Github workflow files while still in progress.
.github/*
